{
  "name": "nuxt-telegram-auth",
  "version": "1.4.0",
  "description": "🔐 Telegram login widget integration for Nuxt",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "telegram",
    "telegram-login",
    "login-widget",
    "auth",
    "authentication"
  ],
  "homepage": "https://halitsever.github.io/nuxt-telegram-auth/",
  "bugs": "https://github.com/halitsever/nuxt-telegram-auth/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/nuxt-telegram-auth.git"
  },
  "license": "MIT",
  "author": "Halit Sever (https://halit.org)",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/runtime/server/tsconfig.json"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground --host",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.6",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
