{
  "name": "nuxt-telegram-auth",
  "version": "1.2.6",
  "description": "🔐 Telegram login widget integration for Nuxt",
  "repository": "https://github.com/halitsever/nuxt-telegram-auth.git",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground --host",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prettier && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.6"
  },
  "devDependencies": {
    "@nuxt/devtools": "^4.0.0-alpha.4",
    "@nuxt/eslint-config": "^1.4.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.6",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.15.21",
    "changelogen": "^0.6.1",
    "eslint": "^9.27.0",
    "nuxt": "^4.4.6",
    "prettier": "^3.5.3",
    "typescript": "latest",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^2.2.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.41.1"
  }
}
