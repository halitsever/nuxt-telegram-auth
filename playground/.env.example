# Telegram Login: BotFather Mini App → your bot → Bot Settings → Login Widget
NUXT_PUBLIC_TELEGRAM_AUTH_CLIENT_ID=
# Only for the redirect login
NUXT_TELEGRAM_AUTH_CLIENT_SECRET=

# Only for the old login widget, on a bot that hasn't switched to Telegram Login
NUXT_TELEGRAM_AUTH_BOT_TOKEN=
NUXT_PUBLIC_BOT_USERNAME=
